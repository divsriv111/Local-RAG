# PostgreSQL Configuration
POSTGRES_PASSWORD=your_secure_password_here

# OpenAI Configuration (required for GPT models)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Vector Database Configuration
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=/data/chromadb

# File Upload Configuration
UPLOAD_FOLDER=/app/uploads
MAX_FILE_SIZE_MB=50

# Document Processing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-ada-002
USE_LOCAL_EMBEDDINGS=false

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
MAX_TOKENS=2000

# Local LLM Configuration (Ollama/LMStudio)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434

# Elasticsearch Configuration (optional)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=rag-chatbot-logs

# API Configuration
API_TITLE=RAG Chatbot LLM Service
API_VERSION=1.0.0
API_DESCRIPTION=FastAPI microservice for LLM interactions and RAG pipeline

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:4200,http://localhost:5000

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Retrieval Configuration
RETRIEVAL_TOP_K=5

# Streaming Configuration
STREAM_CHUNK_SIZE=1

# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================

# 1. Copy this file to .env in the same directory:
#    cp .env.example .env

# 2. Required: Set your OpenAI API key for GPT models
#    Get your key from: https://platform.openai.com/api-keys
#    OPENAI_API_KEY=sk-your-actual-api-key

# 3. Optional: Configure local embeddings
#    Set USE_LOCAL_EMBEDDINGS=true to use HuggingFace models instead of OpenAI
#    This eliminates the need for OPENAI_API_KEY for embeddings

# 4. Optional: Configure local LLM models
#    Install Ollama: https://ollama.ai/download
#    Pull models: ollama pull llama3
#    Or use LMStudio: https://lmstudio.ai/

# 5. Optional: Configure Elasticsearch for logging
#    Leave ELASTICSEARCH_URL empty to disable Elasticsearch logging

# 6. Security: Never commit .env to version control
#    Add .env to .gitignore

# 7. Production: Use strong passwords and secure secret storage
#    Consider using environment-specific .env files
