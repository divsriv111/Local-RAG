# ===================================================
# RAG-Based PDF Chatbot - Environment Configuration
# ===================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with actual secrets
# 3. NEVER commit .env to version control (add to .gitignore)
# 4. Use strong, randomly generated passwords and keys
# 5. For JWT_SECRET_KEY, use: openssl rand -base64 32
#
# ===================================================

# ===================================================
# PostgreSQL Database Configuration
# ===================================================
POSTGRES_DB=rag_chatbot
POSTGRES_USER=raguser
POSTGRES_PASSWORD=your_secure_password_here

# ===================================================
# JWT Authentication Configuration
# ===================================================
JWT_SECRET_KEY=your_256_bit_secret_key_here_minimum_32_characters
JWT_ISSUER=rag-chatbot-api
JWT_AUDIENCE=rag-chatbot-frontend
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ===================================================
# OpenAI Configuration (for GPT models)
# ===================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=

# ===================================================
# Vector Database Configuration (ChromaDB or Qdrant)
# ===================================================
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=/data/chromadb
# For Qdrant, uncomment below:
# VECTOR_DB_TYPE=qdrant
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ===================================================
# LLM Configuration
# ===================================================
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=300

# Local Model Configuration (Ollama/LMStudio)
# LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=llama3

# ===================================================
# Document Processing Configuration
# ===================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50
EMBEDDING_MODEL=text-embedding-ada-002
# For local embeddings, use: sentence-transformers/all-mpnet-base-v2

# ===================================================
# Elasticsearch Configuration
# ===================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=rag-chatbot-logs
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ===================================================
# Application Configuration
# ===================================================
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# Service URLs
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000
PYTHON_SERVICE_URL=http://python-llm:8000

# File Storage
UPLOAD_FOLDER=/app/uploads
MAX_UPLOAD_SIZE_MB=50

# ===================================================
# CORS Configuration
# ===================================================
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# ===================================================
# Logging Configuration
# ===================================================
LOG_LEVEL=Information
LOG_TO_CONSOLE=true
LOG_TO_ELASTICSEARCH=true

# ===================================================
# Database Connection String (Auto-generated)
# ===================================================
# ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# ===================================================
# Optional: Monitoring and Analytics
# ===================================================
# SENTRY_DSN=
# APPLICATION_INSIGHTS_KEY=

# ===================================================
# Optional: Rate Limiting
# ===================================================
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# RATE_LIMIT_BURST_SIZE=10

# ===================================================
# Optional: Cache Configuration
# ===================================================
# REDIS_URL=redis://localhost:6379
# CACHE_EXPIRATION_MINUTES=30

# ===================================================
# Security Configuration
# ===================================================
# Enable HTTPS redirect in production
HTTPS_REDIRECT=false

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# ===================================================
# Development/Debug Settings
# ===================================================
# Set to true only in development
DEBUG_MODE=false
SWAGGER_ENABLED=true
