    "RefreshTokenExpirationDays": "7"
  },
  "FileStorage": {
    "UploadPath": "uploads",
    "MaxFileSizeMB": 50
  },
  "PythonService": {
    "BaseUrl": "http://localhost:8000"
  }
}
