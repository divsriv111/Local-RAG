{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "DevelopmentSecretKeyThatIsAtLeast32CharactersLongForHS256Algorithm",
    "Issuer": "RagChatbotAPI",
    "Audience": "RagChatbotClient",
